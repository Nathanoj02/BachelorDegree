# Elaboratore del circuito (Datapath)
.model DATAPATH

.inputs START PH7 PH6 PH5 PH4 PH3 PH2 PH1 PH0 FINE_DATA VALVOLA_ACIDO VALVOLA_BASICO
# START = inizio, PH[] = pH iniziale, FINE_DATA, VALVOLA_ACIDO, VALVOLA_BASICO date dalla FSM
.outputs PHD7 PHD6 PHD5 PHD4 PHD3 PHD2 PHD1 PHD0 PH_FINALE7 PH_FINALE6 PH_FINALE5 PH_FINALE4 PH_FINALE3 PH_FINALE2 PH_FINALE1 PH_FINALE0 NCLK7 NCLK6 NCLK5 NCLK4 NCLK3 NCLK2 NCLK1 NCLK0
# PHD[] = pH del Datapath, PH_FINALE[] = pH che verrà stampato (compreso tra 7 e 8 inclusi), NCLK[] = numero cicli di clock necessari per portare il pH ad un valore neutro

# Costanti

.subckt ZERO uscita=C0
.subckt ZERO8 O7=C-07 O6=C-06 O5=C-05 O4=C-04 O3=C-03 O2=C-02 O1=C-01 O0=C-00
.subckt UNO8 O7=C-17 O6=C-16 O5=C-15 O4=C-14 O3=C-13 O2=C-12 O1=C-11 O0=C-10
.subckt MEZZO8 O7=C-27 O6=C-26 O5=C-25 O4=C-24 O3=C-23 O2=C-22 O1=C-21 O0=C-20
.subckt QUARTO8 O7=C-37 O6=C-36 O5=C-35 O4=C-34 O3=C-33 O2=C-32 O1=C-31 O0=C-30

# Struttura del datapath

.subckt MUX2I8 A7=PH7 A6=PH6 A5=PH5 A4=PH4 A3=PH3 A2=PH2 A1=PH1 A0=PH0 B7=PHD7 B6=PHD6 B5=PHD5 B4=PHD4 B3=PHD3 B2=PHD2 B1=PHD1 B0=PHD0 S=START O7=PHD-A7 O6=PHD-A6 O5=PHD-A5 O4=PHD-A4 O3=PHD-A3 O2=PHD-A2 O1=PHD-A1 O0=PHD-A0

.subckt REGISTRO8 I7=PHD-A7 I6=PHD-A6 I5=PHD-A5 I4=PHD-A4 I3=PHD-A3 I2=PHD-A2 I1=PHD-A1 I0=PHD-A0 O7=PHD-B7 O6=PHD-B6 O5=PHD-B5 O4=PHD-B4 O3=PHD-B3 O2=PHD-B2 O1=PHD-B1 O0=PHD-B0

.subckt DEMUX2U8 I7=PHD-B7 I6=PHD-B6 I5=PHD-B5 I4=PHD-B4 I3=PHD-B3 I2=PHD-B2 I1=PHD-B1 I0=PHD-B0 S=FINE_DATA X7=PH_FINALE7 X6=PH_FINALE6 X5=PH_FINALE5 X4=PH_FINALE4 X3=PH_FINALE3 X2=PH_FINALE2 X1=PH_FINALE1 X0=PH_FINALE0 Y7=PHD-C7 Y6=PHD-C6 Y5=PHD-C5 Y4=PHD-C4 Y3=PHD-C3 Y2=PHD-C2 Y1=PHD-C1 Y0=PHD-C0

.subckt SOMMATORE8 A7=PHD-C7 A6=PHD-C6 A5=PHD-C5 A4=PHD-C4 A3=PHD-C3 A2=PHD-C2 A1=PHD-C1 A0=PHD-C0 B7=C-37 B6=C-36 B5=C-35 B4=C-34 B3=C-33 B2=C-32 B1=C-31 B0=C-30 CIN=C0 O7=PHD-D7 O6=PHD-D6 O5=PHD-D5 O4=PHD-D4 O3=PHD-D3 O2=PHD-D2 O1=PHD-D1 O0=PHD-D0 COUT=COUT

.subckt MUX2I8 A7=PHD-D7 A6=PHD-D6 A5=PHD-D5 A4=PHD-D4 A3=PHD-D3 A2=PHD-D2 A1=PHD-D1 A0=PHD-D0 B7=PHD-C7 B6=PHD-C6 B5=PHD-C5 B4=PHD-C4 B3=PHD-C3 B2=PHD-C2 B1=PHD-C1 B0=PHD-C0 S=VALVOLA_BASICO O7=PHD-E7 O6=PHD-E6 O5=PHD-E5 O4=PHD-E4 O3=PHD-E3 O2=PHD-E2 O1=PHD-E1 O0=PHD-E0

.subckt SOTTRATTORE8 A7=PHD-E7 A6=PHD-E6 A5=PHD-E5 A4=PHD-E4 A3=PHD-E3 A2=PHD-E2 A1=PHD-E1 A0=PHD-E0 B7=C-27 B6=C-26 B5=C-25 B4=C-24 B3=C-23 B2=C-22 B1=C-21 B0=C-20 BIN=C0 O7=PHD-F7 O6=PHD-F6 O5=PHD-F5 O4=PHD-F4 O3=PHD-F3 O2=PHD-F2 O1=PHD-F1 O0=PHD-F0 BOUT=BOUT

.subckt MUX2I8 A7=PHD-F7 A6=PHD-F6 A5=PHD-F5 A4=PHD-F4 A3=PHD-F3 A2=PHD-F2 A1=PHD-F1 A0=PHD-F0 B7=PHD-E7 B6=PHD-E6 B5=PHD-E5 B4=PHD-E4 B3=PHD-E3 B2=PHD-E2 B1=PHD-E1 B0=PHD-E0 S=VALVOLA_ACIDO O7=PHD7 O6=PHD6 O5=PHD5 O4=PHD4 O3=PHD3 O2=PHD2 O1=PHD1 O0=PHD0


.subckt MUX2I8 A7=C-07 A6=C-06 A5=C-05 A4=C-04 A3=C-03 A2=C-02 A1=C-01 A0=C-00 B7=NCLKD-D7 B6=NCLKD-D6 B5=NCLKD-D5 B4=NCLKD-D4 B3=NCLKD-D3 B2=NCLKD-D2 B1=NCLKD-D1 B0=NCLKD-D0 S=START O7=NCLKD-A7 O6=NCLKD-A6 O5=NCLKD-A5 O4=NCLKD-A4 O3=NCLKD-A3 O2=NCLKD-A2 O1=NCLKD-A1 O0=NCLKD-A0

.subckt REGISTRO8 I7=NCLKD-A7 I6=NCLKD-A6 I5=NCLKD-A5 I4=NCLKD-A4 I3=NCLKD-A3 I2=NCLKD-A2 I1=NCLKD-A1 I0=NCLKD-A0 O7=NCLKD-B7 O6=NCLKD-B6 O5=NCLKD-B5 O4=NCLKD-B4 O3=NCLKD-B3 O2=NCLKD-B2 O1=NCLKD-B1 O0=NCLKD-B0

.subckt DEMUX2U8 I7=NCLKD-B7 I6=NCLKD-B6 I5=NCLKD-B5 I4=NCLKD-B4 I3=NCLKD-B3 I2=NCLKD-B2 I1=NCLKD-B1 I0=NCLKD-B0 S=FINE_DATA X7=NCLK7 X6=NCLK6 X5=NCLK5 X4=NCLK4 X3=NCLK3 X2=NCLK2 X1=NCLK1 X0=NCLK0 Y7=NCLKD-C7 Y6=NCLKD-C6 Y5=NCLKD-C5 Y4=NCLKD-C4 Y3=NCLKD-C3 Y2=NCLKD-C2 Y1=NCLKD-C1 Y0=NCLKD-C0

.subckt SOMMATORE8 A7=NCLKD-C7 A6=NCLKD-C6 A5=NCLKD-C5 A4=NCLKD-C4 A3=NCLKD-C3 A2=NCLKD-C2 A1=NCLKD-C1 A0=NCLKD-C0 B7=C-17 B6=C-16 B5=C-15 B4=C-14 B3=C-13 B2=C-12 B1=C-11 B0=C-10 CIN=C0 O7=NCLKD-D7 O6=NCLKD-D6 O5=NCLKD-D5 O4=NCLKD-D4 O3=NCLKD-D3 O2=NCLKD-D2 O1=NCLKD-D1 O0=NCLKD-D0 COUT=COUT-A


.end

.search C_0.blif
.search C_0_8b.blif
.search C_1_int_8b.blif
.search C_0.5_8b.blif
.search C_0.25_8b.blif
.search mux_2i_8b.blif
.search registro_8b.blif
.search demux_2u_8b.blif
.search sommatore_8b.blif
.search sottrattore_8b.blif
