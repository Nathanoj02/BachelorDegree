# Multiplexer a 2 ingressi a 8 bit
.model MUX2I8

.inputs A7 A6 A5 A4 A3 A2 A1 A0 B7 B6 B5 B4 B3 B2 B1 B0 S	# A[], B[] sono i 2 ingressi, S è il bit di "scelta"
.outputs O7 O6 O5 O4 O3 O2 O1 O0	# O[] è l'output

# Se S = 1 faccio passare A, al contrario B
# Eseguo l'operazione per tutti i bit

.names S A0 B0 O0
11- 1
0-1 1

.names S A1 B1 O1
11- 1
0-1 1

.names S A2 B2 O2
11- 1
0-1 1

.names S A3 B3 O3
11- 1
0-1 1

.names S A4 B4 O4
11- 1
0-1 1

.names S A5 B5 O5
11- 1
0-1 1

.names S A6 B6 O6
11- 1
0-1 1

.names S A7 B7 O7
11- 1
0-1 1

.end
