# Costante 0.25 su 8 bit fixed point (4 + 4)
.model QUARTO8

.outputs O7 O6 O5 O4 O3 O2 O1 O0

.subckt ZERO uscita=O7
.subckt ZERO uscita=O6
.subckt ZERO uscita=O5
.subckt ZERO uscita=O4
.subckt ZERO uscita=O3
.subckt UNO uscita=O2
.subckt ZERO uscita=O1
