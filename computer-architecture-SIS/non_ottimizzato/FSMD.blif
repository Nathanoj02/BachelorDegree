# FSM-D, unione della FSM e del DP
.model FSMD

# Input e Output sono quelli richiesti nelle specifiche del progetto
.inputs RST START PH7 PH6 PH5 PH4 PH3 PH2 PH1 PH0
.outputs FINE_OPERAZIONE ERRORE_SENSORE VALVOLA_ACIDO VALVOLA_BASICO PH_FINALE7 PH_FINALE6 PH_FINALE5 PH_FINALE4 PH_FINALE3 PH_FINALE2 PH_FINALE1 PH_FINALE0 NCLK7 NCLK6 NCLK5 NCLK4 NCLK3 NCLK2 NCLK1 NCLK0

# istanziazione dell’unita' di controllo
.subckt FSM RST=RST START=START PH7=PH7 PH6=PH6 PH5=PH5 PH4=PH4 PH3=PH3 PH2=PH2 PH1=PH1 PH0=PH0 PHD7=PHD7 PHD6=PHD6 PHD5=PHD5 PHD4=PHD4 PHD3=PHD3 PHD2=PHD2 PHD1=PHD1 PHD0=PHD0 FINE_DATA=FINE_DATA FINE_OPERAZIONE=FINE_OPERAZIONE ERRORE_SENSORE=ERRORE_SENSORE VALVOLA_ACIDO=VALVOLA_ACIDO VALVOLA_BASICO=VALVOLA_BASICO

# registri per evitare il network cycle
.subckt REGISTRO I=FINE_DATA O=FINE_DATA-R
.subckt REGISTRO I=VALVOLA_ACIDO O=VALVOLA_ACIDO-R
.subckt REGISTRO I=VALVOLA_BASICO O=VALVOLA_BASICO-R

# istanziazione dell’unita' di elaborazione (datapath)
.subckt DATAPATH START=START PH7=PH7 PH6=PH6 PH5=PH5 PH4=PH4 PH3=PH3 PH2=PH2 PH1=PH1 PH0=PH0 FINE_DATA=FINE_DATA-R VALVOLA_ACIDO=VALVOLA_ACIDO-R VALVOLA_BASICO=VALVOLA_BASICO-R PHD7=PHD7 PHD6=PHD6 PHD5=PHD5 PHD4=PHD4 PHD3=PHD3 PHD2=PHD2 PHD1=PHD1 PHD0=PHD0 PH_FINALE7=PH_FINALE7 PH_FINALE6=PH_FINALE6 PH_FINALE5=PH_FINALE5 PH_FINALE4=PH_FINALE4 PH_FINALE3=PH_FINALE3 PH_FINALE2=PH_FINALE2 PH_FINALE1=PH_FINALE1 PH_FINALE0=PH_FINALE0 NCLK7=NCLK7 NCLK6=NCLK6 NCLK5=NCLK5 NCLK4=NCLK4 NCLK3=NCLK3 NCLK2=NCLK2 NCLK1=NCLK1 NCLK0=NCLK0 

.end

.search FSM_jedi.blif
.search datapath.blif
.search registro.blif
